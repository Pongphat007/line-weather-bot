# ===== LINE Messaging API =====
# ได้จาก LINE Developers Console (https://developers.line.biz/)
# หลัง Enable Messaging API แล้วไปที่ช่อง Channel
# - Channel Secret: แท็บ Basic settings
# - Channel Access Token: แท็บ Messaging API → Issue / Issue long-lived token
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ===== OpenWeatherMap =====
# สมัครฟรีที่ https://openweathermap.org/api แล้วสร้าง API key
# (คีย์ใหม่อาจใช้ได้หลังรอประมาณ 10–30 นาที)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ===== Server =====
# พอร์ตที่ Express จะ listen (Render/Railway มักกำหนด PORT ให้เอง)
PORT=3000

# ===== Cron ภายนอก (แนะนำเมื่อ deploy free tier) =====
# สร้างรหัสลับเอง เช่น openssl rand -hex 16
# ใช้กับ https://your-app.onrender.com/cron/weather?secret=ค่านี้
CRON_SECRET=change_me_to_a_random_secret
