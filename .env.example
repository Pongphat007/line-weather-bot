# ===== LINE Messaging API =====
# ได้จาก LINE Developers Console (https://developers.line.biz/)
# หลัง Enable Messaging API แล้วไปที่ช่อง Channel
# - Channel Secret: แท็บ Basic settings
# - Channel Access Token: แท็บ Messaging API → Issue / Issue long-lived token
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ===== OpenWeatherMap =====
# สมัครฟรีที่ https://openweathermap.org/api แล้วสร้าง API key
# (คีย์ใหม่อาจใช้ได้หลังรอประมาณ 10–30 นาที)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ===== Server =====
# พอร์ตที่ Express จะ listen (Render/Railway มักกำหนด PORT ให้เอง)
PORT=3000

# ===== Cron ภายนอก (แนะนำเมื่อ deploy free tier) =====
# สร้างรหัสลับเอง เช่น openssl rand -hex 16
# ใช้กับ https://your-app.onrender.com/cron/weather?secret=ค่านี้
# และ https://your-app.onrender.com/cron/runs?secret=ค่านี้ (ตารางวิ่งตี 5)
CRON_SECRET=change_me_to_a_random_secret

# ===== Google Sheets (ตารางวิ่ง) =====
# Sheet ID จาก URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
# อีเมลของ Service Account จาก Google Cloud Console (จบด้วย .iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
# Private key จาก JSON ของ Service Account — ใน .env ให้ใส่ทั้งก้อนในบรรทัดเดียว
# โดยแทนขึ้นบรรทัดใหม่ด้วย \n แล้วในโค้ดจะ replace(/\\n/g, '\n') ให้เอง
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# (ทางเลือก) สำรองรายชื่อผู้ใช้แจ้งอากาศเป็น JSON ถ้ายังแชร์ชีทเป็น Viewer
# แนะนำให้แชร์ชีทเป็น Editor แล้วให้บอทเก็บในแท็บ users แทน
# WEATHER_USERS_JSON={"Uxxxx":{"lat":13.7,"lng":100.5,"address":null,"updatedAt":"..."}}
